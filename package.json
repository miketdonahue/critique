{
  "name": "@miketdonahue/critique",
  "version": "0.1.0",
  "description": "Render agent-generated HTML, give point-and-click feedback, and send it to any agent through a CLI long-poll loop.",
  "type": "module",
  "bin": {
    "critique": "bin/critique"
  },
  "files": [
    "bin",
    "dist",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/miketdonahue/critique.git"
  },
  "homepage": "https://github.com/miketdonahue/critique#readme",
  "bugs": {
    "url": "https://github.com/miketdonahue/critique/issues"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:chrome": "vite build -c config/vite.chrome.ts",
    "build:sdk": "vite build -c config/vite.sdk.ts",
    "prepublishOnly": "bun run build",
    "dev": "bun run src/cli.ts",
    "server": "bun run src/cli.ts server",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ scripts/",
    "format": "biome format --write src/ scripts/",
    "check": "bun run typecheck && bun run lint",
    "release": "np"
  },
  "keywords": [
    "agent",
    "cli",
    "html",
    "review",
    "feedback",
    "annotate"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "np": {
    "branch": "main",
    "testScript": "check",
    "message": "chore: release %s"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.1.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "np": "^12.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
